const readline = require("readline");

const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout
    });
rl.question("Nama Lengkap ", (name) => {
    rl.question("Nama Panggilan ", (np) => {
        rl.question("Tempat dan Tanggal Lahir ", (ttl) => {
            rl.question("Jenis Kelamin ", (jk) => {
                rl.question("Nomor Telepon ",(nt) => {
                    rl.question("Email ", (e) => {
                        rl.question("Alamat ", (almt) => {
                        console.log(`Nama Lengkap ${name}`);
                        console.log(`Nama Panggilan ${np}`);
                        console.log(`Tempat dan Tanggal Lahir ${ttl}`);
                        console.log(`Jenis Kelamin ${jk}`);
                        console.log(`Nomor Telepon ${nt}`);
                        console.log(`Email ${e}`);
                        console.log(`Alamat ${almt}`);
                        rl.close();
                    })
                    })
              })
            })
        })
    })
});